# Copy to .env (or run `make up`, which creates .env and asks for the port).
# Compose reads .env automatically. Values here are the defaults.

# Public port for Traefik. 18080 is the port IT approved.
TRAEFIK_HTTP_PORT=18080

# Rootless Docker runtime dir. Find your uid with `id -u`.
XDG_RUNTIME_DIR=/run/user/1011

# Docker daemon socket that Traefik mounts read-only.
DOCKER_SOCKET=/run/user/1011/docker.sock
